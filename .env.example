# ------------------------------------------------------------------------------
# N8N & POSTGRES CONFIGURATION
# ------------------------------------------------------------------------------
# Set timezone
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta

# Database credentials for n8n internal DB
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=n8n_password_change_me
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432

# Database credentials for Clinic Application DB
KLINIK_DB_DATABASE=klinik_db
KLINIK_DB_USER=n8n_user
KLINIK_DB_PASSWORD=n8n_password_change_me

# Default n8n credentials (optional)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password

# ------------------------------------------------------------------------------
# CREDENTIAL PLACEHOLDERS FOR WORKFLOW
# ------------------------------------------------------------------------------
# When setting up n8n for the first time, you must create credentials matching
# these variables in the n8n UI, or pass them via ENV if using env-based credentials.
# Note: For security, the workflow JSONs use placeholders. You need to configure them.

# 1. Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. WhatsApp Business Cloud API
WHATSAPP_CLOUD_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_for_webhook

# 4. Twilio Voice API
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
